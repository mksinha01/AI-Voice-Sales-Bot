# ── Production Domain & SSL (Caddy Automated Let's Encrypt TLS) ──
# Set your domain pointing to your Vultr VPS public IP (A Record)
DOMAIN=salesbot.yourdomain.com

# ── Server & Runtime Configuration ──
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DATABASE_PATH=data/sales_bot.db
RECORDINGS_DIR=data/recordings
LOG_LEVEL=INFO

# ── LiveKit WebRTC Credentials (https://cloud.livekit.io) ──
# Required for low-latency full-duplex WebRTC voice
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Google Gemini LLM Credentials (https://aistudio.google.com) ──
# Required for real-time speech conversation & post-call structured extraction
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_VOICE_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-1.5-flash

# ── Optional Alternative Speech Providers ──
# CARTESIA_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVEN_API_KEY=

# ── Sales Bot Configuration ──
DEFAULT_PRODUCT_NAME="CloudScale CRM"
DEFAULT_LANGUAGE="auto"
RECORDING_CONSENT_DISCLOSURE="Hello! Thanks for connecting. Please note that this sales call is recorded for quality, training, and demonstration purposes. How are you doing today?"
